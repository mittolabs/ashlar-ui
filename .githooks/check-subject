#!/bin/sh
# Reads a commit subject on stdin and fails unless it follows
# docs/engineering/commits.md in the Mittolabs workspace.
subject=$(head -n 1)
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^A-Z].{0,70}[^.]$'
if printf '%s' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi
if printf '%s' "$subject" | grep -Eq '^(Merge|fixup!|squash!)'; then
  exit 0
fi
echo "Not a Conventional Commit: $subject" >&2
echo "Expected: type(scope): subject, lower-case, no trailing period, 72 characters or less." >&2
exit 1
